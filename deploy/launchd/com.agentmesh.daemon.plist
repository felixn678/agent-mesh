<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentmesh.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/agent-mesh</string>
    <string>daemon</string>
    <string>--log-file</string>
    <string>__HOME__/Library/Logs/agent-mesh/daemon.log</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>Umask</key>
  <integer>63</integer>
  <!-- launchd never rotates these: the daemon writes its own rotated log
       (daemon.log, 10 MB x 3); this file only catches startup failures. -->
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/agent-mesh/daemon.stderr.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/agent-mesh/daemon.stderr.log</string>
</dict>
</plist>
